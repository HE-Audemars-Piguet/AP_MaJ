<dx:ThemedWindow x:Class="CH.Hurni.AP_MaJ.Dialogs.VaultUserPasswordCheckDialog"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                 xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                 Title="Confirmation du mot de passe Vault" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow"
                 Loaded="Window_Loaded" FocusManager.FocusedElement="{Binding ElementName=PwdBoxEdit}">
    <dx:ThemedWindow.Style>
        <Style TargetType="dx:ThemedWindow">
            <Setter Property="HeaderBackground" Value="Orange"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProdServer}" Value="True">
                    <Setter Property="HeaderBackground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </dx:ThemedWindow.Style>
    <!--<dx:ThemedWindow.Resources>
        <SolidColorBrush x:Key="{dxt:ThemedWindowThemeKey ResourceKey=WindowActiveHeaderBackground, IsThemeIndependent=True}" Color="Red"/>
    </dx:ThemedWindow.Resources>-->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0 4 0 8">
            <TextBlock Text="Attention, vous semblez vous connecter à un serveur de production!" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0 0 0 4"
                       Visibility="{Binding IsProdServer, Converter={dx:BooleanToVisibilityConverter}}"/>
            <TextBlock Text="Vous êtes sur le point de vous connecter et de modifier les données du Vault suivant:" TextWrapping="Wrap" />
        </StackPanel>

        <Image Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Name="WarningIcon" Source="{dx:DXImage 'SvgImages/Business Objects/BO_Skull.svg'}" 
               HorizontalAlignment="Center" VerticalAlignment="Center"
               dxb:ImageColorizer.Color="Red" dxb:ImageColorizer.IsEnabled="True" Visibility="{Binding IsProdServer, Converter={dx:BooleanToVisibilityConverter}}">
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProdServer}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="32" To="42" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="32" To="42" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Nom du serveur" Margin="16 0" VerticalAlignment="Center"/>
        <dxe:TextEdit Grid.Row="1" Grid.Column="2" EditValue="{Binding Path=Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 2" IsReadOnly="True">
            <dxe:TextEdit.Style>
                <Style TargetType="dxe:TextEdit">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProdServer}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </dxe:TextEdit.Style>
        </dxe:TextEdit>

        <TextBlock Grid.Row="2" Grid.Column="1" Text="Nom du coffre fort" Margin="16 0" VerticalAlignment="Center"/>
        <dxe:TextEdit Grid.Row="2" Grid.Column="2" EditValue="{Binding Path=Vault, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 2" IsReadOnly="True"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Text="Utilisateur" Margin="16 0" VerticalAlignment="Center"/>
        <dxe:TextEdit Grid.Row="3" Grid.Column="2" EditValue="{Binding Path=User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 2"/>
        
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Avant de poursuivre vous devez vous assurez que vous soyez bien connecté au Vault souhaité et confirmer le mot de passe de l'utilisateur." TextWrapping="Wrap"
                   Margin="0 16 0 4"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Text="Mot de passe" Margin="16 0" VerticalAlignment="Center"/>
        <dxe:PasswordBoxEdit Grid.Row="5" Grid.Column="2" Name="PwdBoxEdit" EditValue="{Binding Path=Password, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" ShowPasswordButtonVisibility="Auto" TabIndex="0" Margin="0 2"/>
        
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Name="SavePasswordViewButton" Content="Connect" IsDefault="True" Margin="0 4 2 0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Margin="2 4 0 0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
